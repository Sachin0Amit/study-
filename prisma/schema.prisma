generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Anonymous device-based study progress
model StudySession {
  id        String   @id @default(cuid())
  deviceId  String   @unique
  createdAt DateTime @default(now())
}

model SectionProgress {
  id          String   @id @default(cuid())
  deviceId     String
  sectionKey  String // e.g. "rosen-ch1-s1"
  status      String   @default("in_progress") // in_progress | completed
  lastViewedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([deviceId, sectionKey])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  deviceId    String
  sectionKey String
  score      Int // correct count
  total      Int
  answers    String // JSON array of selected indices
  createdAt  DateTime @default(now())
}

// Personal study notes attached to a lesson (per device)
model SectionNote {
  id         String   @id @default(cuid())
  deviceId   String
  sectionKey String
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([deviceId, sectionKey])
}

// Leitner-box spaced repetition state per flashcard (per device)
// box 0 = new, 1..5 = mastery level; dueAt = next review time
model FlashcardState {
  id        String   @id @default(cuid())
  deviceId  String
  cardKey   String // "<sectionId>::<term>"
  box       Int      @default(0)
  dueAt     DateTime @default(now())
  seen      Int      @default(0) // total times answered
  correct   Int      @default(0) // total times remembered
  updatedAt DateTime @updatedAt

  @@unique([deviceId, cardKey])
}

// Daily study activity for streak tracking + heatmap
// kind: "lesson" | "quiz" | "cards" | "note"  (count = actions of that kind that day)
model StudyActivity {
  id        String   @id @default(cuid())
  deviceId  String
  day       String // "YYYY-MM-DD" (local day, client-supplied)
  kind      String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([deviceId, day, kind])
}

// Starred/pinned formulas (per device); note = personal annotation (printable)
model FormulaFavorite {
  id         String   @id @default(cuid())
  deviceId   String
  formulaKey String // "<chapterId>|<section>|<name>"
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@unique([deviceId, formulaKey])
}

// Timed exam attempts (mixed-chapter quiz simulator)
model ExamAttempt {
  id            String   @id @default(cuid())
  deviceId      String
  label         String // e.g. "Ch 1, 3, 6" or "Full book"
  chapters      String // JSON array of chapterIds
  questionCount Int
  score         Int
  total         Int
  durationSec   Int
  missed        String   @default("[]") // JSON: missed questions (q, options, answer, explanation, provenance, picked)
  createdAt     DateTime @default(now())
}

// Syllabus mapping plans: user types an exam/course name or uploads a document;
// topics get extracted and mapped onto the library catalog
model SyllabusPlan {
  id         String   @id @default(cuid())
  deviceId   String
  title      String
  sourceType String   // "typed" | "uploaded"
  sourceName String   // what the user typed, or the filename
  topics     String   // JSON: [{ topic: string }]
  mapping    String   // JSON: [{ topic, subjectId?, subjectName?, chapterId?, chapterTitle?, confidence, closest? }]
  matched    Int      @default(0)
  total      Int      @default(0)
  // v2 "live & updated" engine bookkeeping
  engineVersion Int   @default(1)  // mapping engine that produced `mapping`
  research    String?              // JSON: [{ title, url, host, date? }] — live web sources used
  pins        String?              // JSON: { "<topic>": "<chapterId>" } — user-confirmed mappings
  refreshedAt DateTime?            // last engine re-map
  refreshCount Int    @default(0)  // how many times re-mapped
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([deviceId, createdAt])
}

// ============ X1 — Cognitive Digital Twin ============

// Streaming evidence events from the new interaction surfaces (studio Q&A,
// arena battles, code-judge runs, lab challenges, palace re-walks). The twin
// ALSO mines the legacy tables (QuizAttempt, FlashcardState, SectionProgress,
// ExamAttempt) — this table captures what they can't.
model TwinEvent {
  id        String   @id @default(cuid())
  deviceId  String
  skillKey  String // sectionId the evidence belongs to
  kind      String // studio | arena | judge | lab | palace | bridge
  correct   Boolean? // right/wrong when the event is gradeable
  weight    Int      @default(1) // evidence strength multiplier
  meta      String? // JSON blob (question text, score detail…)
  createdAt DateTime @default(now())

  @@index([deviceId, skillKey, createdAt])
}

// ============ X2 — Multi-Agent Teaching Studio ============

model StudioThread {
  id          String   @id @default(cuid())
  deviceId    String
  title       String   @default("New consultation")
  persona     String   @default("professor") // professor | examiner | drill | planner | researcher
  mode        String   @default("chat") // chat | debate | roundtable
  style       String? // learned cognitive-style preference (from debate votes)
  targetSkill String? // sectionId the thread focuses on (examiner/drill/lesson-ask)
  styleCounts String? // JSON {intuition: n, rigor: n, examples: n} — debate vote tally
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deviceId, updatedAt])
}

model StudioMessage {
  id        String   @id @default(cuid())
  threadId  String
  deviceId  String
  role      String // user | assistant
  persona   String? // which faculty member produced it
  content   String
  citations String? // JSON [{sectionId, number, title, chapterTitle}]
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

// ============ X4 — Curriculum Remix Engine ============

model RemixPlan {
  id          String   @id @default(cuid())
  deviceId    String
  goal        String // free-text study goal
  horizonDays Int      @default(14)
  sequence    String // JSON [{skillKey, number, title, chapterId, chapterTitle, subjectId, priority, reason, pKnown, bridge}]
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deviceId, updatedAt])
}

// LLM-generated gap-filling lessons ("you're weak in integration before EM
// fields" → a bridge lesson is authored once, cached, slotted into the plan).
model BridgeLesson {
  id        String   @id @default(cuid())
  deviceId  String
  skillKey  String // the section this bridge leads INTO
  gapKeys   String // JSON: prerequisite skill keys being bridged
  title     String
  content   String // JSON {intro, objectives[], concepts[], takeaways[]}
  createdAt DateTime @default(now())

  @@unique([deviceId, skillKey])
}

// ============ X7 — Paper-DNA Forensic Analyzer ============

model PaperAnalysis {
  id        String   @id @default(cuid())
  deviceId  String
  title     String
  files     String // JSON [{name, year, questionCount}]
  questions String // JSON [{text, year, chapterId?, chapterTitle?, subjectName?, type, difficulty}]
  stats     String // JSON {hotTopics[], drift[], typeMix, predictions[], crossTwin[]}
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

// ============ Exam Command Center — deep-researched exam syllabus maps ============
// The user types any exam name (dynamic input); live web research produces a
// hierarchical map: overview → subjects → units → topics, each topic auto-mapped
// onto library chapters. Multiple maps are saved per device for switching.
model ExamMap {
  id        String   @id @default(cuid())
  deviceId  String
  name      String   // the exam name the user typed
  overview  String   // JSON: ExamOverview
  subjects  String   // JSON: ExamSubject[]
  sources   String   // JSON: [{ title, url, host, date? }]
  stats     String   // JSON: { subjectCount, unitCount, topicCount, mappedCount }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deviceId, updatedAt])
}

// ============ X10 — Review Mode (SM-2 spaced repetition) ============
// Per-lesson review cards: quiz questions, key terms and takeaways become
// two-sided cards scheduled by the classic SM-2 algorithm (ease factor +
// growing intervals). Single-user local app — no deviceId scoping needed.

model ReviewCard {
  id            String    @id @default(cuid())
  sectionId     String
  sectionTitle  String
  front         String
  back          String
  kind          String    @default("term") // quiz | term | takeaway
  reps          Int       @default(0)
  lapses        Int       @default(0)
  interval      Float     @default(0) // days until due
  ease          Float     @default(2.5)
  dueAt         DateTime  @default(now())
  lastGrade     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([sectionId, front])
  @@index([dueAt])
}

// One row per UTC day — how many review answers were given that day
// (streaks + the 7-day sparkline on the Review dashboard).
model ReviewLog {
  id        String   @id @default(cuid())
  day       String   @unique // "YYYY-MM-DD" (UTC)
  reviews   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ X8 — Memory Palace Generator ============

model MemoryPalace {
  id         String    @id @default(cuid())
  deviceId   String
  sectionKey String
  rooms      String // JSON [{name, scene, facts[], imagePrompt, image, narration, audio}]
  status     String    @default("pending") // pending | generating | ready | failed
  error      String?
  dueAt      DateTime?
  walks      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([deviceId, sectionKey])
}

// ============ X9 — AI Lesson Illustrator ============

model LessonIllustration {
  id          String   @id @default(cuid())
  sectionKey  String   @unique
  prompt      String
  style       String
  imageBase64 String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ X11 — Focus HQ (Pomodoro + to-dos + study-time analytics) ============
// A Pomodoro-style deep-work system: tasks ("to-do today" with pomodoro
// estimates, Cirillo-style) + timed focus/break sessions. Every session logs
// WHAT it was spent on (task, subject, chapter) and HOW LONG, so analytics can
// answer "what did I study, for how much time".

model FocusTask {
  id          String    @id @default(cuid())
  deviceId    String
  title       String
  subject     String? // subject name label, e.g. "Mathematics"
  subjectId   String? // library subject id when linked, e.g. "mathematics"
  bookId      String? // library book id when linked
  estimate    Int       @default(2) // estimated pomodoros
  done        Int       @default(0) // completed pomodoros logged against it
  interruptions Int     @default(0) // internal + external interruptions
  completed   Boolean   @default(false)
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deviceId, completed, position])
}

model FocusExam {
  id        String   @id @default(cuid())
  deviceId  String
  title     String // e.g. "JEE Main 2027"
  examDate  String // local "YYYY-MM-DD" — the D-day
  note      String? // optional plan / exam-center line
  createdAt DateTime @default(now())

  @@index([deviceId, examDate])
}

model FocusSession {
  id           String   @id @default(cuid())
  deviceId     String
  kind         String   @default("focus") // focus | short_break | long_break
  taskId       String?
  taskTitle    String?
  subject      String?
  subjectId    String?
  chapterId    String?
  chapterTitle String?
  plannedMin   Int      @default(25)
  actualSec    Int      @default(0)
  completed    Boolean  @default(true) // false = stopped early (partial credit)
  interruptions Int     @default(0)
  note         String? // optional journal line ("how did it go?") attached after a session
  day          String // local "YYYY-MM-DD"
  startedAt    DateTime @default(now())
  endedAt      DateTime @default(now())

  @@index([deviceId, day])
  @@index([deviceId, subject])
}
